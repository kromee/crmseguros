# ─── MySQL (Docker: docker compose up -d) ───
DATABASE_URL="mysql://crm:crm_password@localhost:3306/crmseguros"
DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_USER="crm"
DATABASE_PASSWORD="crm_password"
DATABASE_NAME="crmseguros"

# Auth.js (NextAuth v5)
AUTH_SECRET="genera-un-secret-aleatorio-con-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_PRODUCT_NAME="Seguros CRM"
NEXT_PUBLIC_PRODUCT_TAGLINE="Gestión profesional para agentes de seguros"
NEXT_PUBLIC_APP_NAME="Seguros CRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Soporte (página /support)
SUPPORT_EMAIL="soporte@segurosvale.com"
SUPPORT_PHONE="+52 55 1234 5678"
SUPPORT_WHATSAPP_URL="https://wa.me/525512345678"

# Storage (archivos locales — carpeta en raíz del proyecto)
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# Producción: false tras npm run uploads:migrate -- --apply
# En NODE_ENV=production el legacy ya está desactivado por defecto
ALLOW_LEGACY_UPLOAD_PATHS="false"
