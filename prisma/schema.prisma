generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  USER
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum LicenseStatus {
  AVAILABLE
  USED
  REVOKED
  EXPIRED
}

/// Vigencia de la licencia / suscripción al activar
enum LicenseTerm {
  MONTHLY
  ANNUAL
  MONTHS_24
  YEARS_4
}

enum ContactType {
  CLIENT
  PROSPECT
}

enum ContactOrigin {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  RECOMENDADO
  FAMILIA
  AMIGO
  STAND
  GOOGLE_MAPS
  PUBLICIDAD
  SITIO_WEB
  OTRO
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum PolicyType {
  VIDA
  AUTO
  OTRO
}

enum CoverageType {
  AMPLIA
  LIMITADA
  BASICA
  RC
}

enum Currency {
  MXN
  USD
  UDI
}

enum PaymentFrequency {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CHEQUE
  DOMICILIACION
  OTRO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWAL
}

enum PensionLaw {
  IMSS_LEY73
  AFORE_LEY97
  OTRO
}

enum PensionRequestType {
  ASESORIA
  TRAMITE
  OTRO
}

enum ServiceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleServiceType {
  ALTA
  BAJA
  PLACAS_NUEVAS
  RENOVACION_PLACAS
  TARJETA_CIRCULACION
  OTRO
}

enum VehicleRequestMode {
  COTIZACION
  TRAMITE
}

enum ProspectStage {
  CONTACTO_INICIAL
  SEGUIMIENTO
  COTIZACION
  CIERRE
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  ATENCION
}

enum ProspectStatus {
  ACTIVE
  WON
  LOST
}

enum ActivityType {
  LLAMADA
  EMAIL
  WHATSAPP
  NOTA
  VISITA
  DOCUMENTO
}

enum ActivityResult {
  EXITOSO
  PENDIENTE
  SIN_RESPUESTA
  FINALIZADO
}

enum EventType {
  RENOVACION
  COBRO_PAGO
  SEGUIMIENTO
  LLAMADA
  TAREA
}

enum EventStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskType {
  LLAMADA
  EMAIL
  VISITA
  REUNION
  OTRO
}

enum NextActionType {
  LLAMADA
  CITA
  EMAIL
  OTRO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
}

// ─────────────────────────────────────────
// SAAS — PLATAFORMA MULTI-TENANT
// ─────────────────────────────────────────

model Plan {
  id             String   @id @default(uuid())
  slug           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  maxUsers       Int      @default(2)
  storageLimitMb Int      @default(5120)
  priceMonthly   Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenants       Tenant[]
  subscriptions Subscription[]
  licenses      License[]

  @@map("plans")
}

model Tenant {
  id             String       @id @default(uuid())
  name           String       @db.VarChar(200)
  slug           String       @unique @db.VarChar(80)
  logo           String?      @db.VarChar(500)
  slogan         String?      @db.VarChar(300)
  status         TenantStatus @default(PENDING)
  planId         String
  maxUsers       Int          @default(2)
  storageLimitMb Int          @default(5120)
  catalogSettings Json?       @map("catalog_settings")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plan          Plan           @relation(fields: [planId], references: [id])
  users         User[]
  subscriptions Subscription[]
  licenses      License[]
  contacts      Contact[]
  policies      Policy[]
  pensionServices PensionService[]
  vehicleServices VehicleService[]
  payments      Payment[]
  prospects     Prospect[]
  activities    Activity[]
  calendarEvents CalendarEvent[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("tenants")
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String
  planId    String
  term      LicenseTerm
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model License {
  id        String        @id @default(uuid())
  code      String        @unique @db.VarChar(32)
  keyHash   String        @db.VarChar(255)
  planId    String
  term      LicenseTerm
  status    LicenseStatus @default(AVAILABLE)
  tenantId  String?
  expiresAt DateTime?
  usedAt    DateTime?
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  plan   Plan    @relation(fields: [planId], references: [id])
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([tenantId])
  @@map("licenses")
}

// ─────────────────────────────────────────
// MODELOS
// ─────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String   @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole @default(USER)
  avatar    String?  @db.VarChar(500)
  title     String?  @db.VarChar(100)
  isActive     Boolean  @default(true)
  sessionNonce     String?   @db.VarChar(36)
  sessionActiveAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts       Contact[]       @relation("AssignedContacts")
  prospects      Prospect[]      @relation("AssignedProspects")
  calendarEvents CalendarEvent[]
  activities     Activity[]
  auditLogs      AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model Contact {
  id         String        @id @default(uuid())
  tenantId   String
  code       String        @db.VarChar(20) // SM-XXXX por tenant
  type       ContactType   @default(PROSPECT)
  fullName   String        @db.VarChar(200)
  phone      String        @db.VarChar(20)
  email      String?       @db.VarChar(255)
  photo      String?       @db.VarChar(500) // ruta de foto de perfil en /uploads
  birthDate  DateTime?     @db.Date
  activity   String?       @db.VarChar(200) // Ocupación / actividad profesional
  city       String?       @db.VarChar(100)
  state      String?       @db.VarChar(100)
  origin     ContactOrigin
  status     ContactStatus @default(PENDING)
  notes      String?       @db.Text
  assignedTo String?

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser   User?            @relation("AssignedContacts", fields: [assignedTo], references: [id])
  policies       Policy[]
  pensionServices PensionService[]
  vehicleServices VehicleService[]
  prospects      Prospect[]
  activities     Activity[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, type, status])
  @@index([assignedTo])
  @@index([phone])
  @@index([email])
  @@map("contacts")
}

model Policy {
  id               String           @id @default(uuid())
  tenantId         String
  contactId        String
  policyNumber     String           @db.VarChar(100)
  type             PolicyType
  plan             String?          @db.VarChar(200)
  insurer          String?          @db.VarChar(200) // GNP, AXA, Qualitas, Mapfre...
  startDate        DateTime         @db.Date
  endDate          DateTime         @db.Date
  paymentFrequency PaymentFrequency @default(ANUAL)
  premium          Decimal          @db.Decimal(12, 2)
  sumInsured       Decimal?         @db.Decimal(15, 2)
  beneficiaries    String?          @db.Text
  status           PolicyStatus     @default(ACTIVE)
  documents        Json?            // rutas de archivos
  notes            String?          @db.Text

  // Campos específicos de AUTO
  insuredAsset     String?          @db.Text      // Descripción del auto / bien asegurado
  coverageType     CoverageType?                  // Amplia, Limitada, Básica, RC
  vehiclePhoto     String?          @db.VarChar(500) // foto del vehículo

  // Campos específicos de VIDA
  currency         Currency?                      // MXN, USD, UDI
  term             String?          @db.VarChar(100) // Plazo (ej. "20 años", "vitalicio")

  // Archivo adjunto de la póliza
  policyFile       String?          @db.VarChar(500) // ruta del archivo PDF/imagen

  // Trazabilidad de renovaciones
  renewedFromId    String?          @unique
  renewedFrom      Policy?  @relation("PolicyRenewals", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy        Policy?  @relation("PolicyRenewals")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  activities Activity[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, policyNumber])
  @@index([tenantId, contactId])
  @@index([renewedFromId])
  @@index([endDate])
  @@index([status])
  @@map("policies")
}

model PensionService {
  id              String             @id @default(uuid())
  tenantId        String
  contactId       String
  requestDate     DateTime           @db.Date
  requestType     PensionRequestType @default(ASESORIA)
  pensionLaw      PensionLaw?
  cost            Decimal            @db.Decimal(10, 2)
  advance         Decimal?           @db.Decimal(10, 2)
  advanceDate     DateTime?          @db.Date
  settlement      Decimal?           @db.Decimal(10, 2)
  settlementDate  DateTime?          @db.Date
  description     String?            @db.Text
  bitacora        String?            @db.Text
  status          ServiceStatus      @default(PENDING)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, contactId])
  @@map("pension_services")
}

model VehicleService {
  id          String              @id @default(uuid())
  tenantId    String
  contactId   String
  startDate   DateTime            @db.Date
  serviceType VehicleServiceType
  requestMode VehicleRequestMode  @default(TRAMITE)
  description String?             @db.Text
  quote       Decimal?            @db.Decimal(10, 2)
  status      ServiceStatus       @default(PENDING)
  documents   Json?               // { ine: bool, tarjetaCirculacion: bool, factura: bool, titulo: bool }

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, contactId])
  @@map("vehicle_services")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  policyId      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime      @db.Date
  periodStart   DateTime?     @db.Date
  periodEnd     DateTime?     @db.Date
  method        PaymentMethod @default(TRANSFERENCIA)
  reference     String?       @db.VarChar(100) // Num. operación, folio, etc.
  notes         String?       @db.Text
  status        PaymentStatus @default(CONFIRMED)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, policyId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

model Prospect {
  id                String         @id @default(uuid())
  tenantId          String
  code              String         @db.VarChar(20) // PR-XXX por tenant
  contactId         String
  stage             ProspectStage  @default(CONTACTO_INICIAL)
  priority          Priority       @default(MEDIA)
  serviceOfInterest String?        @db.VarChar(200)
  estimatedValue    Decimal?       @db.Decimal(12, 2)
  probability       Int            @default(50) // 0-100
  assignedTo        String?
  notes             String?        @db.Text
  nextActionType    NextActionType?
  nextActionDate    DateTime?
  rating            Int            @default(3) // 1-5 estrellas
  status            ProspectStatus @default(ACTIVE)

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?      @relation("AssignedProspects", fields: [assignedTo], references: [id])
  activities   Activity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, stage, status])
  @@index([assignedTo])
  @@map("prospects")
}

model Activity {
  id          String         @id @default(uuid())
  tenantId    String
  contactId   String
  prospectId  String?
  policyId    String?
  type        ActivityType
  summary     String         @db.Text
  result      ActivityResult @default(PENDIENTE)
  performedBy String
  isAutomatic Boolean        @default(false)
  attachments Json?          // rutas archivos

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  prospect    Prospect? @relation(fields: [prospectId], references: [id])
  policy      Policy?   @relation(fields: [policyId], references: [id])
  performer   User      @relation(fields: [performedBy], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId, contactId])
  @@index([prospectId])
  @@index([createdAt])
  @@map("activities")
}

model CalendarEvent {
  id              String      @id @default(uuid())
  tenantId        String
  title           String      @db.VarChar(300)
  type            EventType
  contactId       String?
  userId          String
  startDate       DateTime
  endDate         DateTime
  description     String?     @db.Text
  priority        Priority    @default(MEDIA)
  notifyClient    Boolean     @default(false)
  notifyAgent     Boolean     @default(true)
  reminderMinutes Int         @default(15)
  attachments     Json?
  status          EventStatus @default(PENDING)
  syncGoogle      Boolean     @default(false)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, startDate])
  @@index([type, status])
  @@map("calendar_events")
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String?
  userId    String
  entity    String      @db.VarChar(100)
  entityId  String      @db.VarChar(36)
  action    AuditAction
  changes   Json?
  ipAddress String?     @db.VarChar(50)
  createdAt DateTime    @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([userId])
  @@map("audit_log")
}

model LoginRateLimit {
  email        String   @id @db.VarChar(255)
  attemptCount Int      @default(0)
  resetAt      DateTime
  lastIp       String?  @db.VarChar(50)
  updatedAt    DateTime @updatedAt

  @@map("login_rate_limits")
}
